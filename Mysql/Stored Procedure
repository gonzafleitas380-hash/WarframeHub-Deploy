-- 12. guardar compra
DELIMITER $$

CREATE PROCEDURE sp_guardar_compra(
    IN p_id_usuario INT,
    IN p_nombre_item VARCHAR(100),
    IN p_item_url_nombre VARCHAR(255),
    IN p_vendedor VARCHAR(45),
    IN p_precio DECIMAL(10,2),
    IN p_estado_vendedor VARCHAR(45)
)
BEGIN
    INSERT INTO compras_guardadas (
        id_usuario,
        nombre_item,
        item_url_nombre,
        vendedor,
        precio,
        estado_vendedor,
        fecha_guardado
    )
    VALUES (
        p_id_usuario,
        p_nombre_item,
        p_item_url_nombre,
        p_vendedor,
        p_precio,
        p_estado_vendedor,
        NOW()
    );

    SELECT LAST_INSERT_ID() AS id_compra_guardada;
END$$
DELIMITER ;

-- 13. eliminar compra
DELIMITER $$

CREATE PROCEDURE sp_eliminar_compra(
    IN p_id_compra INT
)
BEGIN
    DELETE FROM compras_guardadas
    WHERE id_compra = p_id_compra;

    SELECT ROW_COUNT() AS filas_afectadas;
END$$
DELIMITER ;

-- 14. obtener compras
DELIMITER $$

CREATE PROCEDURE sp_obtener_compras(
    IN p_id_usuario INT
)
BEGIN
    SELECT
        id_compra,
        nombre_item,
        item_url_nombre,
        vendedor,
        precio,
        estado_vendedor,
        fecha_guardado
    FROM compras_guardadas
    WHERE id_usuario = p_id_usuario
    ORDER BY fecha_guardado DESC;
END$$

DELIMITER ;


