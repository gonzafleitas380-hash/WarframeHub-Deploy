# ============================================================
# Dockerfile — Frontend (SPA React/Vite → build estático → nginx)
# ============================================================

# --- Stage 1: build ---
# Nota: esta versión de Node NO tiene que coincidir con la del backend.
# Esta imagen se descarta al final del build (stage 2 es nginx puro),
# así que acá solo importa cumplir el mínimo que pide Vite 8 (22.12+).
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build   # genera /app/dist ya minificado y bundleado (Vite/Rollup)

# --- Stage 2: imagen final, solo sirve archivos estáticos ---
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
